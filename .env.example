# Copier ce fichier vers .env puis adapter les valeurs :
#   PowerShell : Copy-Item .env.example .env
#   Linux/macOS : cp .env.example .env
# Le fichier .env n'est JAMAIS versionné (voir .gitignore).

# --- PostgreSQL ---
POSTGRES_USER=orders
POSTGRES_PASSWORD=change_me
POSTGRES_DB=orders
# Base utilisée par les tests d'intégration (créée automatiquement par pytest)
POSTGRES_TEST_DB=orders_test
# Adresse vue depuis votre machine (en local). Dans Docker, l'application utilise "db:5432" automatiquement.
POSTGRES_HOST=localhost
# Port de la MACHINE exposé par le conteneur db (changer si 5432 est déjà pris, ex. 5433)
POSTGRES_PORT=5432

# --- Application ---
# Port de la MACHINE exposé par le conteneur app
APP_PORT=8000
